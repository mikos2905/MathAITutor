# Grading mode. "mock" (default) returns fake feedback and costs nothing —
# use it for building and for exercising the UI. "live" calls Claude.
GRADER=mock

# Required only when GRADER=live. Get one at https://console.anthropic.com
# and set a monthly spend limit on it before you start testing.
ANTHROPIC_API_KEY=

# Reasoning depth. Reasoning tokens bill as output, so this is the main cost
# lever: "high" (default) marks most carefully, "medium" costs roughly half.
GRADER_EFFORT=high

# Set to 1 to log token usage per grade to the server console, so you can see
# what caching is actually saving you instead of guessing.
GRADER_LOG_USAGE=0
